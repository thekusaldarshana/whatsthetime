    <!-- JS -->
    <script>
      // Theme toggle
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const html = document.documentElement;
        const isDark = html.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });

      // Init theme from localStorage
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark') document.documentElement.classList.add('dark');

      // Blog search
      const searchInput = document.getElementById('searchInput');
      const cards = document.querySelectorAll('#postContainer > a');

      searchInput?.addEventListener('input', () => {
        const query = searchInput.value.toLowerCase();
        cards.forEach(card => {
          const text = card.dataset.title;
          card.style.display = text.includes(query) ? 'block' : 'none';
        });
      });
    </script>

    <!-- Live Clock Script -->
    <script is:inline>
      function updateLiveTime() {
        const el = document.getElementById("live-time");
        const now = new Date();
        el.textContent = now.toLocaleTimeString();
      }

      updateLiveTime();
      setInterval(updateLiveTime, 1000);
    </script>

    <!-- Analytics components -->
  <Analytics />
  <SpeedInsights />
  </body>
  <script defer data-name="BMC-Widget" data-cfasync="false" src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js" data-id="thekusaldarshana" data-description="Support me on Buy me a coffee!" data-message="Glad to See you Here! Thank you for Visiting." data-color="#40DCA5" data-position="Right" data-x_margin="18" data-y_margin="18"></script>
</html>
