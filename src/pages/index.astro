---
import TimeConverter from "../components/TimeConverter.astro";
import NewsFeed from '../components/NewsFeed.astro';
import WorldClockCards from '../components/WorldClockCards.astro';
import ChargeDoseBanner from "../components/ChargeDoseBanner.astro";
import AdSense from "../components/AdSense.astro";
import AdUnit from "../components/AdUnit.astro";
import Seo from "../components/Seo.astro";
import "../styles/global.css";
import Analytics from '@vercel/analytics/astro'
import  SpeedInsights  from "@vercel/speed-insights/astro"
import { AD_SLOTS } from "../lib/ads.js";
import { SITE_URL, absoluteUrl, faqPage } from "../lib/site.js";
import SourceButton from "../components/SourceButton.astro";

const title = "Time Zone Converter & Meeting Planner | What's The Time";
const description = "Instantly convert between time zones, check the current local time anywhere in the world, and schedule international meetings with our accurate and easy-to-use world clock.";

const faqs = [
  {
    question: "How do I convert a time between two time zones?",
    answer: "Pick the source city or time zone in the \u201CFrom\u201D field, pick the destination in the \u201CTo\u201D field and set a time. What's The Time instantly shows the converted local time, including the current UTC offset and daylight saving changes."
  },
  {
    question: "Is What's The Time free to use?",
    answer: "Yes. The time zone converter, world clock and meeting planner are free, need no account and work on any device."
  },
  {
    question: "Does it handle daylight saving time (DST)?",
    answer: "Yes. Conversions use the IANA time zone database, so daylight saving transitions are applied automatically for every city and date you choose."
  },
  {
    question: "How do I find a meeting time that works across time zones?",
    answer: "Open the Meeting Planner, add every participant's city and the planner highlights the hours that fall inside working hours for everyone."
  },
  {
    question: "Can I embed the world clock on my own site?",
    answer: "Yes. The /embed page is an iframe-ready widget you can drop into any website free of charge."
  }
];

const webApplication = {
  "@type": "WebApplication",
  "@id": `${SITE_URL}/#webapp`,
  name: "What's The Time",
  url: `${SITE_URL}/`,
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "All",
  browserRequirements: "Requires JavaScript and a modern web browser.",
  inLanguage: "en-US",
  screenshot: absoluteUrl("/og-preview.png"),
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  featureList: [
    "Global Time Zone Conversion",
    "World Clock Display",
    "Meeting Scheduler Across Time Zones",
    "Daylight Saving Time Awareness"
  ],
  publisher: { "@id": `${SITE_URL}/#organization` }
};
