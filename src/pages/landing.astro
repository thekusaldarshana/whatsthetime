---
import Layout from '../layouts/Layout.astro';
import TimeConverter from "../components/TimeConverter.astro";
import MeetingPlanner from "../components/MeetingPlanner.jsx";
import ChargeDoseBanner from "../components/ChargeDoseBanner.astro";
import Analytics from '@vercel/analytics/astro';
import  SpeedInsights  from "@vercel/speed-insights/astro"
import AdSense from "../components/AdSense.astro";
import AdUnit from "../components/AdUnit.astro";
import Seo from "../components/Seo.astro";
import { AD_SLOTS } from "../lib/ads.js";
import { SITE_URL, breadcrumbs, faqPage } from "../lib/site.js";
import SourceButton from "../components/SourceButton.astro";

const title = "What's The Time – Global Time Converter, World Clock & Meeting Planner";
const description = "Convert time zones instantly, see the current time anywhere in the world and schedule international meetings with a fast, modern and mobile-friendly world clock.";

const faqs = [
  {
    question: "What is whatsthetime.top?",
    answer: "It is a modern time conversion tool that visually adapts to the real world \u2014 your time, your place, your vibe. It is mobile friendly, so global time is always in your pocket."
  },
  {
    question: "How is it different from other time converters?",
    answer: "It brings together UX, real-time visuals and contextual information such as weather and emoji \u2014 all in one place."
  },
  {
    question: "Is this tool free to use?",
    answer: "Yes, it is 100% free and ad-light (we only use ethical sponsorships)."
  },
  {
    question: "Do you store any of my data?",
    answer: "No personal data is stored. Zone detection is purely local/IP-based."
  },
  {
    question: "Can I share a time conversion?",
    answer: "Soon you will be able to share conversions via short links."
  },
  {
    question: "Do I need to install anything?",
    answer: "No installation is required. It works instantly in your browser on any device."
  },
  {
    question: "Will more features be added?",
    answer: "Yes. AI-based suggestions, shared links and travel info are on the roadmap."
  }
];

const softwareApplication = {
  "@type": "SoftwareApplication",
  name: "What's The Time",
  url: `${SITE_URL}/`,
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "All",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@id": `${SITE_URL}/#organization` }
};
