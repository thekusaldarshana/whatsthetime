  <button id="theme-toggle" class="p-2 rounded-full border border-gray-300 dark:border-gray-700 bg-white dark:bg-black text-black dark:text-white shadow-md">
          🌓
  </button>
</div>
</nav>

<!-- Mobile Bottom Nav Buttons -->
<div class="fixed bottom-10 mb-4 mx-auto left-1/2 transform -translate-x-1/2 z-50 md:hidden px-4 py-2 bg-white/20 backdrop-blur-md border border-whites/40 rounded-full flex gap-6 text-lg font-semibold tracking-tight shadow-lg">
  <a href="/landing" target="blank" class="text-lg font-semibold tracking-tight text-center">About</a>
    <a href="/popular" target="blank" class="text-lg font-semibold tracking-tight text-center">Popular</a>
    
    <!-- Tools Dropdown Button for Mobile -->
      <div class="relative">
        <button
          onclick="toggleMobileToolsDropdown()"
          class="flex items-center gap-1 text-lg font-semibold tracking-tight"
