  <!-- Desktop Nav Buttons -->
  <div class="hidden md:grid md:grid-cols-5 gap-10 items-center px-4 py-2 bg-white/10 backdrop-blur-md border border-white/50 rounded-full">
  <div class="relative group">
    <a href="/landing" target="_blank" class="text-lg font-semibold tracking-tight hover:scale-110">🏠</a>
