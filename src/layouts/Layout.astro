---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro";
import Feedback from "../components/Feedback.astro";
import ChargeDoseBanner from "../components/ChargeDoseBanner.astro";
import AdSense from "../components/AdSense.astro";
import AdUnit from "../components/AdUnit.astro";
import Seo from "../components/Seo.astro";
import "../styles/global.css";
import { AD_SLOTS } from "../lib/ads.js";

const {
  title = "What's The Time – Global Time Converter, World Clock Meeting Planner & Scheduler",
  description = "Easily convert time zones and view current times anywhere in the world with the No #1 Fastest Global Time Converter",
  keywords,
  image,
  type = "website",
  noindex = false,
  graph = []
} = Astro.props;
---

<html lang="en" class="scroll-smooth dark">
<head>
  <!-- Primary Meta -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

  <Seo
    title={title}
    description={description}
    keywords={keywords}
    image={image}
    type={type}
    noindex={noindex}
    graph={graph}
  />

  <!-- Favicons & Manifest -->
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="whatsthetime" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Theme + Verification -->
  <meta name="theme-color" content="#fde047" />
  <meta name="google-site-verification" content="gKcYaMKLR1jRCwqQfkI-tf-7WGvBxfFvjliDoRtAV8o" />

  <!-- Preconnects -->
  <link rel="preconnect" href="https://mn-tz.com" crossorigin />
  <link rel="preconnect" href="https://cmp.gatekeeperconsent.com" crossorigin />
  <link rel="preconnect" href="https://the.gatekeeperconsent.com" crossorigin />
  <link rel="preconnect" href="//www.ezojs.com" crossorigin />

  <!-- Async Ads & Consent -->
  <script async is:inline src="https://mn-tz.com/NDI0NDE2.js?t=424416" data-noptimize="1" data-cfasync="false" data-wpfc-render="false"></script>
  <script async is:inline src="https://cmp.gatekeeperconsent.com/min.js" data-cfasync="false"></script>
  <script async is:inline src="https://the.gatekeeperconsent.com/cmp.min.js" data-cfasync="false"></script>
  <script async is:inline src="//www.ezojs.com/ezoic/sa.min.js"></script>
  <script is:inline>
    window.ezstandalone = window.ezstandalone || {};
    window.ezstandalone.cmd = window.ezstandalone.cmd || [];
  </script>

  <!-- Google AdSense -->
  <AdSense />
</head>


  <body class="bg-[#fbfceb] text-[#1a1a1a] transition-colors duration-300 dark:bg-[#0b0f19] dark:text-white">

    <header class="w-full px-4 py-2 flex items-center justify-between bg-white dark:bg-baseDark shadow-sm relative z-50">
