---
// A single AdSense placement. Requires <AdSense /> in the page <head>, which
// loads the library and fills every <ins> on the page in document order.
import { ADSENSE_CLIENT, ADS_ENABLED } from '../lib/ads.js';

const {
  slot,
  format = 'auto',
  layout,
  layoutKey,
  fullWidthResponsive = true,
  label = 'Sponsored',
  minHeight = '280px',
  class: className = '',
} = Astro.props;
---

{ADS_ENABLED && (
<div class={`w-full ${className}`}>
  <div class="bg-yellow-50 dark:bg-gray-900 border border-yellow-300 dark:border-white/10 rounded-lg p-4 shadow text-sm text-gray-800 dark:text-gray-200">
    <p class="font-semibold mb-2 text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400">
      {label}
    </p>
    <ins
      class="adsbygoogle block"
      style={`display:block;min-height:${minHeight};text-align:center;`}
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot}
      data-ad-format={format}
      data-ad-layout={layout}
      data-ad-layout-key={layoutKey}
      data-full-width-responsive={fullWidthResponsive ? 'true' : 'false'}></ins>
  </div>
</div>
)}
