</div>
</header>

<ChargeDoseBanner />

    <!-- Layout with Sidebar Ad -->
    <div class="flex flex-col lg:flex-row gap-6 px-4 mt-6 animate-fadeIn">
      <!-- Main Content -->
      <main class="flex-1">
        <slot />
      </main>

      <!-- Sponsored Ad Sidebar -->
      <aside id="sponsored-sidebar" class="w-full lg:w-72">
        <AdUnit slot={AD_SLOTS.sidebar} minHeight="380px" />
      </aside>
    </div>

    <!-- Sponsored Inline Ad Card -->
    <div class="mt-8 mb-10 px-4">
      <AdUnit
        slot={AD_SLOTS.inline}
        format="fluid"
        layoutKey="-f7+5u+4t-da+6l"
        minHeight="180px"
      />
    </div>

    <!-- Footer -->
    <footer class="border-t border-gray-200 dark:border-white/10 bg-slate-900 text-sm py-10 px-4 md:px-12 mt-10">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between gap-6 text-gray-600 dark:text-gray-400">
        <div>
          <a href="/" class="font-bold text-gray-800 dark:text-white mb-2">⏱ What's The Time</a>
          <p class="max-w-md">Modern time converter helping global citizens work, meet, and plan across time zones. <span> <a href="/">© 2025 whatsthetime.</a> </span> Made with ❤️ and ⚡ in Sri Lanka.</p>
        </div>
        <div class="flex gap-6 flex-wrap">
          <div>
            <p class="font-semibold text-gray-700 dark:text-white mb-1">Quick Links</p>
            <ul class="space-y-1">
