  <!-- Mobile Bottom Nav Buttons -->
<div class="fixed bottom-4 left-1/2 transform -translate-x-1/2 z-50 md:hidden px-4 py-2 bg-white/20 backdrop-blur-md border border-white/40 rounded-full flex gap-6 text-lg font-semibold tracking-tight shadow-lg">
  <div class="relative group">
