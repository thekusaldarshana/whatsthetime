    <a href="/blog" class="text-lg font-semibold tracking-tight text-center">Blog</a>
</div>

<script defer is:inline>
  let mobileToolsOpen = false;
  function toggleMobileToolsDropdown() {
    const dropdown = document.getElementById("mobileToolsDropdown");
    const arrow = document.getElementById("mobileToolsArrow");
    mobileToolsOpen = !mobileToolsOpen;
    dropdown.classList.toggle("hidden", !mobileToolsOpen);
    dropdown.classList.toggle("scale-100", mobileToolsOpen);
    dropdown.classList.toggle("opacity-100", mobileToolsOpen);
    arrow.classList.toggle("rotate-180", mobileToolsOpen);
  }
</script>

<ChargeDoseBanner />

  <div class="flex flex-col lg:flex-row gap-6 px-4 mt-6 animate-fadeIn">


